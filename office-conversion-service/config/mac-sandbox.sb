; This profile is a template. IsolationService substitutes the job/runtime
; roots and their literal ancestor traversal rules for every request before
; invoking sandbox-exec.
(version 1)
(deny default)
(allow process-fork)
(allow process-exec)
(allow signal (target self))
(allow sysctl-read)
; dyld and the macOS loader inspect the filesystem root itself during startup.
; This literal directory grant does not grant reads of files under `/`.
(allow file-read* (literal "/"))
(allow file-read* (subpath "${JOB_DIR}"))
(allow file-read* (subpath "${LIBREOFFICE_ROOT}"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/etc"))
(allow file-read* (subpath "/dev"))
(allow file-read* (subpath "/Library/Fonts"))
(allow file-read* (subpath "/System/Library/Fonts"))
(allow file-read* (subpath "/private/var/db"))
(allow file-write* (subpath "${JOB_DIR}"))
(deny network*)

; LibreOffice startup consults these narrowly scoped macOS services even with
; SAL_USE_VCLPLUGIN=svp. They do not grant pasteboard access or host network
; access. The socket bind below is restricted to this request's job path.
(allow mach-lookup (global-name "com.apple.coreservices.launchservicesd"))
(allow mach-lookup (global-name "com.apple.windowserver.active")
                  (global-name "com.apple.hiservices-xpcservice")
                  (global-name "com.apple.ViewBridgeAuxiliary"))
(allow file-read* (literal "/private/etc/passwd"))
(allow file-read-metadata (literal "/tmp") (literal "/var"))
(allow network-bind network-inbound network-outbound (subpath "${JOB_DIR}"))

; Ancestor literal read rules are generated by IsolationService for the
; configured job and LibreOffice runtime roots.
${JOB_ANCESTOR_RULES}
${RUNTIME_ANCESTOR_RULES}
